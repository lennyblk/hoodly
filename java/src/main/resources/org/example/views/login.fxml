<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>

   <Label text="Hoodly — Administration" style="-fx-font-size: 26; -fx-font-weight: bold;" />
   <Label text="Connectez-vous avec votre compte Hoodly" style="-fx-text-fill: #777;" />

   <TextField fx:id="emailField" promptText="Adresse e-mail" minWidth="260.0" />
   <PasswordField fx:id="passwordField" promptText="Mot de passe" minWidth="260.0" />

   <Label fx:id="errorLabel" textFill="red" />

   <Button text="Se connecter (SSO)" onAction="#handleLogin" minWidth="260.0"
           style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>

   <Separator style="-fx-padding: 4 0 4 0;"/>

   <Label text="Pas de connexion disponible ?" style="-fx-text-fill: #777; -fx-font-size: 11;" />
   <Button text="Continuer en mode hors connexion" onAction="#handleOfflineAccess" minWidth="260.0"
           style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 8;"/>
</VBox>
