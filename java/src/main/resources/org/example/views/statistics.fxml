<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.StatisticsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="10">
       <Button text="← Retour" onAction="#goBack" styleClass="button-primary" style="-fx-text-fill: white;"/>
       <Label text="Statistiques globales des Incidents" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-padding: 0 0 0 20;" />
   </HBox>

   <HBox spacing="30" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
       <VBox alignment="CENTER" spacing="10" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 15;" styleClass="vbox-card">
           <Label text="Répartition Ouverts / Résolus (Derniers 7 jours)" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
           <PieChart fx:id="statusChart" prefWidth="350" prefHeight="350" />
       </VBox>
       
       <VBox alignment="CENTER" spacing="10" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 15;" styleClass="vbox-card">
           <Label text="Thèmes d'incidents (Derniers 7 jours)" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
           <BarChart fx:id="categoryChart" prefWidth="450" prefHeight="350" legendVisible="false">
              <xAxis>
                <CategoryAxis label="Thème/Catégorie" />
              </xAxis>
              <yAxis>
                <NumberAxis label="Nombre de tickets" />
              </yAxis>
           </BarChart>
       </VBox>
   </HBox>
</VBox>